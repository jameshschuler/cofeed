{
  "name": "cofeed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "node .output/server/index.mjs",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:reset": "tsx src/db/scripts/reset-cofeed-data.ts",
    "db:seed": "tsx src/db/seeds/seed.ts",
    "db:seed:james": "SEED_USER_EMAIL=jameshschuler1+cofeed@gmail.com tsx src/db/seeds/seed.ts",
    "db:seed:shared": "SEED_MODE=shared tsx src/db/seeds/seed.ts",
    "db:seed:test": "SEED_MODE=test tsx src/db/seeds/seed.ts",
    "db:reset:seed": "npm run db:reset && npm run db:seed",
    "db:expose-schemas": "tsx src/db/scripts/expose-cofeed-schema.ts",
    "db:grant": "tsx src/db/scripts/grant-cofeed-schema.ts",
    "db:studio": "drizzle-kit studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
